<Page x:Class="Library.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Library.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthorizationPage"
      
      Background="Wheat">

    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">

            <StackPanel Orientation="Horizontal">
                <Label FontFamily="Times New Roman" FontSize="22">Логин:</Label>
                <TextBox Name="tbLog" Margin="5" Width="200"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label FontFamily="Times New Roman" FontSize="22">Пароль:</Label>
                <PasswordBox Name="passBox" Margin="5" Width="200"></PasswordBox>
            </StackPanel>


            <Button Name="btnLog" Content="Войти" Margin="5" 
                    FontFamily="Times New Roman" FontSize="22"
                    Height="30" Width="120"
                    Click="btnLog_Click"></Button>

            <Button Name="btnGuest" Content="Гость" Margin="5" 
                    FontFamily="Times New Roman" FontSize="22"
                    Height="30" Width="120"
                    Click="btnGuest_Click"></Button>
        </StackPanel>

    </Grid>
</Page>
