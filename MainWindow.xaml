<Window x:Class="Library.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="69*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="SandyBrown"></Grid>
        <Grid Grid.Row="2" Background="SandyBrown"></Grid>

        <DockPanel LastChildFill="False">
            <TextBlock x:Name="tbName"
                       Grid.Row="0"
                       TextWrapping="Wrap"
                       Text="{Binding ElementName=FrameMain, Path=Content.Title}"
                       FontFamily="Times New Roman"
                       FontSize="26"
                       DockPanel.Dock="Top"
                       HorizontalAlignment="Center"
                       Margin="10"
                       
                       Width="274"
                       ></TextBlock>
        </DockPanel>

        <DockPanel LastChildFill="False">
            <Button Content="Назад" HorizontalAlignment="Right"
                    FontFamily="Times New Roman" FontSize="26"
                    Background="White"
                    DockPanel.Dock="Bottom"
                    Margin="10" Name="btnBack"
                    Width="140" Height="40"/>
        </DockPanel>


        <Frame x:Name="FrameMain" NavigationUIVisibility="Hidden" Grid.Row="1" Background="Wheat"></Frame>
    </Grid>
</Window>
